# Copy to .env and fill locally. Do NOT commit .env
OCI_CLI_PROFILE=DEFAULT
OCI_REGION=ap-singapore-1
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..REPLACE_ME
OCI_SUBNET_ID=ocid1.subnet.oc1.ap-singapore-1.REPLACE_ME
OCI_AVAILABILITY_DOMAIN=REPLACE_ME:AP-SINGAPORE-1-AD-1
# Path to SSH public key used for new instances (private key stays only on your machine)
SSH_PUBLIC_KEY_FILE=~/.ssh/oci_always_free.pub
# Optional: pin image OCIDs; leave empty to auto-pick free Ubuntu 24.04 Minimal
OCI_IMAGE_AMD=
OCI_IMAGE_ARM=
