# =============================================================================
# .env 範例 / Example — 複製為 .env 後填寫；勿提交 .env
# Copy to .env and fill locally. Do NOT commit .env
# =============================================================================

# OCI CLI profile name in ~/.oci/config（通常 DEFAULT）
OCI_CLI_PROFILE=DEFAULT

# Region（Always Free 建議 home region；預設新加坡）
OCI_REGION=ap-singapore-1

# 必填：compartment OCID（tenancy 或子 compartment）
# Required: compartment OCID
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..REPLACE_ME

# 必填：subnet OCID（須有 public IP 可用）
# Required: subnet OCID (must allow public IP)
OCI_SUBNET_ID=ocid1.subnet.oc1.ap-singapore-1.REPLACE_ME

# 選填：availability domain；空白則自動取第一個
# Optional: leave empty to auto-pick first AD
OCI_AVAILABILITY_DOMAIN=

# SSH 公鑰路徑（私鑰請留在本機，勿放入此目錄）
# Path to SSH public key (keep private key only on your machine)
SSH_PUBLIC_KEY_FILE=~/.ssh/oci_always_free.pub

# 選填：固定映像 OCID；空白則自動挑 Ubuntu 24.04 Minimal 免費映像
# Optional: pin image OCIDs; leave empty to auto-pick free Ubuntu 24.04 Minimal
OCI_IMAGE_AMD=
OCI_IMAGE_ARM=

# -----------------------------------------------------------------------------
# API KEY 私鑰放哪裡 / Where the API KEY PEM goes
# -----------------------------------------------------------------------------
# 1. 在 Oracle Cloud Console 產生 API Key，下載私鑰 .pem
# 2. 放在本機安全路徑，例如：~/.oci/oci_api_key.pem（權限 600）
# 3. 在 ~/.oci/config 的 [DEFAULT] 指向該檔，範例：
#
# [DEFAULT]
# user=ocid1.user.oc1..REPLACE_ME
# fingerprint=aa:bb:cc:...
# tenancy=ocid1.tenancy.oc1..REPLACE_ME
# region=ap-singapore-1
# key_file=~/.oci/oci_api_key.pem
#
# 本工具只呼叫 `oci` CLI，不會內嵌任何金鑰。
# This tool only invokes the `oci` CLI; it never embeds keys.
